# Optional. Without a key, SkillProof uses its built-in demo viva and answer rubric.
LLM_API_KEY=
# OpenAI-compatible chat completions endpoint
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
PORT=3001
# Requirement-change notification delay for an assessment session (3 minutes by default).
REQUIREMENT_CHANGE_DELAY_MS=180000
# Optional automatic retention for non-demo assessment records. 0 disables cleanup.
DATA_RETENTION_DAYS=0
